#!/usr/bin/env bash
# bin/release-prepare-test — tests for bin/release-prepare. No network, no GitHub
# sign-in: run it anywhere, CI included (ci.yml runs it on every pull request).
#
#   bin/release-prepare-test
set -euo pipefail

# The files bin/release-prepare reads the version from and bumps.
FILES="version.go"

# ---------------------------------------------------------------------------
# Shared by rail0-ts, rail0-ruby, rail0-go and rail0-cli; only FILES above differs.
#
# Builds a throwaway repository with a bare "origin", copies bin/release-prepare and the
# version files into it, tags the current version, merges a few pull requests, and then
# drives the script: --dry-run output (version, grouped notes), each refusal, and one
# real run against a fake `gh`, checking the branch and commit it pushes. `gh`, `pnpm`
# and `bundle` are stubs on PATH, so the test needs no network and no GitHub sign-in.
# ---------------------------------------------------------------------------

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$ROOT/bin/release-prepare"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/release-prepare-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

failures=0
pass() { printf 'ok   %s\n' "$1"; }
fail() { printf 'FAIL %s\n' "$1"; failures=$((failures + 1)); }
expect_contains() { # NAME OUTPUT NEEDLE
  case "$2" in *"$3"*) pass "$1" ;; *) fail "$1: expected '$3' in:"; printf '%s\n' "$2" | sed 's/^/     | /' ;; esac
}
expect_absent() {
  case "$2" in *"$3"*) fail "$1: did not expect '$3'" ;; *) pass "$1" ;; esac
}

# Stubs. `gh` is signed in, cannot see a GitHub repo (so the notes come from git, as
# they do without gh), and "opens" a pull request by printing a URL. For the branch mode
# it knows one pull request when FAKE_PR is set ("NUMBER<TAB>STATE<TAB>BASE"), answers its
# title and body from FAKE_PR_TITLE / FAKE_PR_BODY, and `pr edit` saves the new body to
# $FAKE_PR_EDITED.
mkdir -p "$TMP/stubs"
cat >"$TMP/stubs/gh" <<'EOF'
#!/usr/bin/env bash
case "$1 ${2:-}" in
  "auth status") exit 0 ;;
  "pr create") echo "https://github.com/example/repo/pull/99" ;;
  "pr view")
    [ -n "${FAKE_PR:-}" ] || exit 1
    case "$*" in
      *number,state,baseRefName*) printf '%s\n' "$FAKE_PR" ;;
      *"--json title"*) printf '%s\n' "$FAKE_PR_TITLE" ;;
      *"--json body"*) printf '%s\n' "$FAKE_PR_BODY" ;;
      *"--json url"*) echo "https://github.com/example/repo/pull/42" ;;
      *) exit 1 ;;
    esac ;;
  "pr edit")
    while [ $# -gt 0 ]; do
      [ "$1" = --body-file ] && cp "$2" "$FAKE_PR_EDITED"
      [ "$1" = --title ] && printf '%s\n' "$2" >"$FAKE_PR_EDITED.title"
      shift
    done ;;
  *) exit 1 ;;
esac
EOF
printf '#!/usr/bin/env bash\nexit 0\n' >"$TMP/stubs/pnpm"
printf '#!/usr/bin/env bash\nexit 0\n' >"$TMP/stubs/bundle"
chmod +x "$TMP/stubs/"*
export PATH="$TMP/stubs:$PATH"
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
unset RELEASE_PREPARE_SKIP_GIT_CHECKS GH_TOKEN GITHUB_TOKEN 2>/dev/null || true

git init --quiet --bare "$TMP/origin.git"
git clone --quiet "$TMP/origin.git" "$TMP/work" 2>/dev/null
cd "$TMP/work"
git switch --quiet -c main 2>/dev/null || git checkout --quiet -b main
git config commit.gpgsign false
git config tag.gpgsign false
mkdir -p bin
cp "$SCRIPT" bin/release-prepare
for f in $FILES; do
  mkdir -p "$(dirname "$f")"
  cp "$ROOT/$f" "$f"
done
# A pull request may require a PSEUDO-version of an unreleased rail0-go branch (ci.yml
# builds it); a real run refuses one by design, and that refusal is not what these tests
# exercise — so the fixture's go.mod requires a tag. A no-op without a go.mod, or with a
# tagged requirement.
if [ -f go.mod ]; then
  sed -E 's#(github\.com/commercelayer/rail0-go) v[^[:space:]]+-([0-9]+\.)?[0-9]{14}-[0-9a-f]{12}#\1 v1.0.0#' go.mod >go.mod.tmp
  mv go.mod.tmp go.mod
fi
git add -A
git commit --quiet -m "initial"
git push --quiet origin main

run() { "$BASH" bin/release-prepare "$@" </dev/null 2>&1; }

# The current version, as the script itself reads it.
current="$(run --dry-run | sed -n 's/^  version:  \([0-9.]*\) -> .*/\1/p')"
[ -n "$current" ] || { echo "could not read the current version from a dry run"; run --dry-run; exit 1; }
git tag "v$current"
git push --quiet origin main --tags

merge_pr() { # NUMBER TITLE
  git switch --quiet -c "pr-$1"
  echo "$1" >>changes.txt
  git add changes.txt
  git commit --quiet -m "work for #$1"
  git switch --quiet main
  git merge --quiet --no-ff "pr-$1" -m "Merge pull request #$1 from example/pr-$1" -m "$2"
}
merge_pr 10 "feat(payments): add the thing"
merge_pr 12 "chore(release): v9.9.9"
merge_pr 13 "refactor!: remove the legacy client"
merge_pr 14 "docs: explain the thing"
echo squash >>changes.txt && git add changes.txt && git commit --quiet -m "fix: correct the rounding (#11)"
git push --quiet origin main

IFS=. read -r x y z <<<"$current"
patch="$x.$y.$((z + 1))"
minor="$x.$((y + 1)).0"
major="$((x + 1)).0.0"

out="$(run --dry-run)"
expect_contains "no argument: the bump is computed (a '!' makes it major)" "$out" "-> v$major"
expect_contains "computed bump in the dry run" "$out" "bump:     major (computed)"
expect_contains "the PR body names what decided it" "$out" "- refactor!: remove the legacy client (#13)"
expect_absent "a lower level does not decide a major" "$out" "- feat(payments): add the thing (#10)"
expect_contains "the PR body says how it was computed" "$out" "**Version:** **major**, computed"
expect_contains "Added: feat with its scope" "$out" "- **payments:** add the thing (#10)"
expect_contains "Fixed: squash-merged fix" "$out" "- correct the rounding (#11)"
expect_contains "Removed: breaking removal" "$out" "- remove the legacy client **(breaking)** (#13)"
expect_contains "Changed: docs" "$out" "- explain the thing (#14)"
expect_absent "previous release PRs are left out" "$out" "9.9.9"
expect_contains "notes inside the markers" "$out" "<!-- release-notes:end -->"
[ -z "$(git status --porcelain)" ] && pass "dry run writes nothing" || fail "dry run changed the tree"

out="$(run minor --dry-run)"
expect_contains "minor by hand" "$out" "-> v$minor"
expect_contains "a manual bump says so, and what it overrides" "$out" "set by hand (\`bin/release-prepare minor\`); the computed bump would be **major**"
expect_contains "explicit version with a v" "$(run "v$minor" --dry-run)" "-> v$minor"
expect_contains "refuses the current version" "$(run "$current" --dry-run || true)" "is not greater than"
expect_contains "refuses non-semver" "$(run 1.2 --dry-run || true)" "is not X.Y.Z"
expect_contains "refuses two versions" "$(run 1.2.3 1.2.4 --dry-run || true)" "one version at most"

echo dirt >dirt.txt
expect_contains "refuses a dirty tree" "$(run --dry-run || true)" "not clean"
rm dirt.txt

git switch --quiet -c topic
expect_contains "a branch must be on origin" "$(run --dry-run || true)" "is not on origin"
expect_contains "test override works with --dry-run" \
  "$(RELEASE_PREPARE_SKIP_GIT_CHECKS=1 run --dry-run)" "-> v$major"
expect_contains "test override refused without --dry-run" \
  "$(RELEASE_PREPARE_SKIP_GIT_CHECKS=1 run || true)" "honoured only with --dry-run"
git switch --quiet main

git commit --quiet --allow-empty -m "local only"
expect_contains "refuses main ahead of origin/main" "$(run --dry-run || true)" "not in sync"
git reset --quiet --hard origin/main

git push --quiet origin "HEAD:refs/heads/chore/release-$major"
expect_contains "refuses an existing release branch" "$(run --dry-run || true)" "already exists on origin"
git push --quiet origin --delete "chore/release-$major"

# A real run, against the stubbed gh.
out="$(run)"
expect_contains "real run opens the PR" "$out" "opened the release pull request"
expect_contains "and ends with its URL" "$(printf '%s\n' "$out" | tail -n 1)" "https://github.com/example/repo/pull/99"
[ "$(git symbolic-ref --short HEAD)" = main ] && pass "back on main" || fail "not back on main"
if git ls-remote --exit-code --heads origin "chore/release-$major" >/dev/null; then
  pass "release branch pushed"
  git fetch --quiet origin "chore/release-$major"
  subject="$(git log -1 --format=%s FETCH_HEAD)"
  [ "$subject" = "chore(release): v$major" ] && pass "commit subject" || fail "commit subject: $subject"
  changed="$(git diff --name-only origin/main FETCH_HEAD | tr '\n' ' ')"
  for f in $changed; do
    case " $FILES " in *" $f "*) ;; *) fail "unexpected file in the release commit: $f" ;; esac
  done
  [ -n "$changed" ] && pass "release commit touches only version files ($changed)" || fail "release commit is empty"
  if git diff origin/main FETCH_HEAD | grep '^+' | grep -qF "$major"; then
    pass "version files bumped to $major"
  else
    fail "version files not bumped to $major"
  fi
else
  fail "release branch not pushed"
fi
[ -z "$(git tag -l "v$major")" ] && pass "no tag created locally" || fail "a tag was created"

# The computed bump, level by level: each case releases what merged since a fresh tag.
retag() { git tag "$1" && git push --quiet origin "$1"; }
retag "v$major"
merge_pr 20 "fix(api): handle the 404"
merge_pr 21 "feat(wallets): list the balances"
merge_pr 22 "docs: typo"
git push --quiet origin main
out="$(run --dry-run)"
expect_contains "a feat makes it minor" "$out" "-> v$((x + 1)).1.0"
expect_contains "the feat decided it" "$out" "- feat(wallets): list the balances (#21)"

retag "v$((x + 1)).1.0"
merge_pr 23 "fix: round down"
merge_pr 24 "chore(deps): bump the SDK"
git push --quiet origin main
out="$(run --dry-run)"
expect_contains "fixes and chores make it a patch" "$out" "-> v$((x + 1)).1.1"
expect_contains "every patch-level PR is listed" "$out" "- chore(deps): bump the SDK (#24)"

retag "v$((x + 1)).1.1"
echo footer >>changes.txt && git add changes.txt &&
  git commit --quiet -m "feat: new signing flow (#25)" -m "BREAKING CHANGE: the old signer is gone"
git push --quiet origin main
out="$(run --dry-run)"
expect_contains "a BREAKING CHANGE footer makes it major" "$out" "-> v$((x + 2)).0.0"
expect_contains "and marks the note as breaking" "$out" "new signing flow **(breaking)** (#25)"

retag "v$((x + 2)).0.0"
expect_contains "refuses when nothing merged" "$(run --dry-run || true)" "nothing merged since"
expect_contains "unless a version is forced" "$(run patch --dry-run)" "-> v$((x + 2)).0.1"

# --- branch mode: the branch's own pull request carries the release -------------------
retag "v$((x + 2)).0.1"
git switch --quiet -c feature
echo feature >>changes.txt && git add changes.txt && git commit --quiet -m "work on the feature"
expect_contains "branch: refuses without its pull request" "$(run --dry-run || true)" "is not on origin"
git push --quiet -u origin feature
expect_contains "branch: refuses without an open pull request" "$(run --dry-run || true)" "has no pull request"
export FAKE_PR=$'42\tOPEN\tmain' FAKE_PR_TITLE="feat(x): a new thing" FAKE_PR_EDITED="$TMP/edited.md"
export FAKE_PR_BODY=$'Adds the new thing.\n\nDetails here.'
# The latest tag is v(x+2).0.1 (retagged above): a feat on top of it is (x+2).1.0.
bx=$((x + 2))
bminor="$bx.1.0"
out="$(run --dry-run)"
expect_contains "branch: dry run says the mode" "$out" "mode:     branch (feature, pull request #42)"
expect_contains "branch: its own feat makes it minor" "$out" "-> v$bminor"
expect_contains "branch: its own title is in the notes" "$out" "- **x:** a new thing (#42)"
expect_contains "branch: the description is kept" "$out" "Adds the new thing."
expect_contains "branch: the release block is marked" "$out" "<!-- release:start -->"

FAKE_PR_BODY=$'Removes the old thing.\n\nBREAKING CHANGE: the old thing is gone' \
  expect_contains "branch: a BREAKING CHANGE footer in its description makes it major" \
  "$(FAKE_PR_BODY=$'Removes the old thing.\n\nBREAKING CHANGE: the old thing is gone' run --dry-run)" "-> v$((bx + 1)).0.0"

git switch --quiet main
git commit --quiet --allow-empty -m "fix: something on main (#43)" && git push --quiet origin main
git switch --quiet feature
expect_contains "branch: refuses a branch behind main" "$(run --dry-run || true)" "does not contain origin/main"
git merge --quiet --no-edit origin/main && git push --quiet origin feature

out="$(run)"
expect_contains "branch: real run updates the pull request" "$out" "pull request #42 now releases v$bminor"
expect_contains "branch: and ends with its URL" "$(printf '%s\n' "$out" | tail -n 1)" "https://github.com/example/repo/pull/42"
[ "$(git symbolic-ref --short HEAD)" = feature ] && pass "branch: stays on the branch" || fail "branch: left the branch"
git fetch --quiet origin feature
subject="$(git log -1 --format=%s origin/feature)"
[ "$subject" = "chore(release): v$bminor" ] && pass "branch: bump committed and pushed on the branch" ||
  fail "branch: last commit on origin/feature is '$subject'"
edited="$(cat "$FAKE_PR_EDITED" 2>/dev/null || true)"
expect_contains "branch: the description keeps its text" "$edited" "Adds the new thing."
expect_contains "branch: the notes are in the description" "$edited" "<!-- release-notes:start -->"
expect_contains "branch: main's fix is in the notes too" "$edited" "something on main (#43)"
[ -z "$(git tag -l "v$bminor")" ] && pass "branch: no tag created" || fail "branch: a tag was created"
expect_contains "branch: the title says it releases" "$(cat "$FAKE_PR_EDITED.title")" "feat(x): a new thing (release v$bminor)"

# A second run replaces the block instead of adding one, and does not bump again.
FAKE_PR_BODY="$edited" FAKE_PR_TITLE="$(cat "$FAKE_PR_EDITED.title")"
out="$(run)"
expect_contains "branch: re-run leaves the version alone" "$out" "already carries $bminor"
edited="$(cat "$FAKE_PR_EDITED")"
[ "$(cat "$FAKE_PR_EDITED.title")" = "feat(x): a new thing (release v$bminor)" ] &&
  pass "branch: re-run replaces the title suffix" || fail "branch: title is '$(cat "$FAKE_PR_EDITED.title")'"
expect_absent "branch: the suffix stays out of the notes" "$edited" "(release v$bminor) (#42)"
[ "$(printf '%s\n' "$edited" | grep -c '<!-- release:start -->')" = 1 ] &&
  pass "branch: re-run keeps one release block" || fail "branch: release block duplicated"
[ "$(git log -1 --format=%s origin/feature)" = "chore(release): v$bminor" ] &&
  [ "$(git rev-list --count origin/main..origin/feature)" -le 4 ] &&
  pass "branch: re-run adds no commit" || fail "branch: re-run committed again"

FAKE_PR=$'42\tCLOSED\tmain' expect_contains "branch: refuses a closed pull request" \
  "$(FAKE_PR=$'42\tCLOSED\tmain' run --dry-run || true)" "is CLOSED, not open"
unset FAKE_PR FAKE_PR_TITLE FAKE_PR_BODY FAKE_PR_EDITED
git switch --quiet main

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failure(s)"
  exit 1
fi
echo "all release-prepare tests passed"
